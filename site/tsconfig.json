{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "allowUmdGlobalAccess": true,
    "paths": {
      "@ds": [
        "../ui/src/ds"
      ],
      "@ds/*": [
        "../ui/src/ds/*"
      ]
    }
  }
}
