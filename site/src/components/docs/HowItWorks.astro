---
// How a run fits together, for the docs Overview. Plain SVG coloured with the design
// system tokens, so it follows the docs' light and dark themes.
const box = (x: number, y: number, w: number, h: number) => ({ x, y, width: w, height: h, rx: 10 });
---
<figure class="how">
  <svg viewBox="0 0 700 245" role="img" aria-labelledby="how-title how-desc">
    <title id="how-title">How honest-agent runs an eval</title>
    <desc id="how-desc">
      honest-agent takes your evals, asks each question with the model you choose and the
      tools from your agent's MCP server, grades each answer, and shows the results in a
      report: accuracy and provenance.
    </desc>
    <defs>
      <marker id="how-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="tip" />
      </marker>
    </defs>

    <rect {...box(0, 10, 170, 96)} class="node" />
    <text x="85" y="50" class="t">Your evals</text>
    <text x="85" y="74" class="s">questions you know</text>
    <text x="85" y="92" class="s">the answers to</text>

    <rect {...box(255, 10, 190, 96)} class="node main" />
    <text x="350" y="44" class="t main">honest-agent</text>
    <text x="350" y="68" class="s main">asks with your model,</text>
    <text x="350" y="86" class="s main">grades each answer</text>

    <rect {...box(530, 10, 170, 96)} class="node yours" />
    <text x="615" y="50" class="t">Your agent's</text>
    <text x="615" y="72" class="t">MCP server</text>
    <text x="615" y="94" class="s">its tools and your data</text>

    <rect {...box(255, 170, 190, 70)} class="node" />
    <text x="350" y="200" class="t">Report</text>
    <text x="350" y="222" class="s">accuracy and provenance</text>

    <line x1="170" y1="58" x2="253" y2="58" class="arrow" />
    <line x1="445" y1="44" x2="528" y2="44" class="arrow" />
    <line x1="530" y1="74" x2="447" y2="74" class="arrow" />
    <line x1="350" y1="106" x2="350" y2="168" class="arrow" />
  </svg>
  <figcaption>
    honest-agent doesn't call your agent app: it plays the agent, with the model you choose
    and the tools from your agent's MCP server.
  </figcaption>
</figure>

<style>
  .how { margin: 1.5rem 0; }
  svg { width: 100%; height: auto; display: block; }
  .node { fill: var(--bg-surface); stroke: var(--border-2); stroke-width: 1.25; }
  .node.main { fill: var(--accent); stroke: var(--accent); }
  .node.yours { fill: var(--bg-sunken); stroke-dasharray: 5 4; }
  text { text-anchor: middle; font-family: var(--font-sans); fill: var(--fg-1); }
  .t { font-family: var(--font-display); font-size: 18px; font-weight: 500; }
  .s { font-size: 14px; fill: var(--fg-2); }
  .main { fill: var(--accent-fg); }
  .arrow { stroke: var(--fg-3); stroke-width: 1.5; fill: none; marker-end: url(#how-arrow); }
  .tip { fill: var(--fg-3); }
  figcaption { margin-top: 0.75rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
</style>
