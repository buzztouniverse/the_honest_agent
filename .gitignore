# honest-agent results (generated by `honest-agent run`, local storage default)
honest_agent_results/
honest_agent_report/

# Python
__pycache__/
*.pyc
.venv/
.venv*/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# DuckDB
*.duckdb
*.duckdb.wal

# env
.env

# Local project config: copy honest_agent_config.example.yml (holds your own URLs and accounts)
example_project/honest_agent_config.yml

# wrangler (Cloudflare) local cache: holds the account ID
.wrangler/

# The site (site/): installed packages, build output and Astro's cache, plus the hero
# video's local copy (it's served from Cloudflare R2, see site/README.md)
node_modules/
.astro/
site/dist/
site/media/
